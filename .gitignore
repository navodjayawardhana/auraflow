# ─── Datasets ────────────────────────────────────────────────
# Raw research data is NEVER committed. It is redistributable under
# CC BY 4.0 (LifeSnaps) / CC BY-NC 4.0 (PMData), but it is 600 MB+ and
# must be fetched from the canonical source so provenance stays verifiable.
#   → run: python ml/download_data.py
# NOTE: `data/raw/*` not `data/raw/` — git cannot re-include a file with `!`
# if its parent directory itself is excluded.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artefacts (regenerated by ml/train.py)
*.h5
*.keras
ml/artifacts/*
# ...except the shipped model. It is 2.4 KB of JSON, it is what the app actually
# loads, and tracking it means the exact deployed coefficients are reviewable and
# tied to the commit that produced them.
!ml/artifacts/focus_model_coefficients.json
mobile/assets/models/*.tflite
!mobile/assets/models/.gitkeep

# ─── Secrets ─────────────────────────────────────────────────
.env
.env.*
!.env.example
secrets.h
*.pem
*.p12
*.keystore
google-services.json
GoogleService-Info.plist

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ─── Node / React Native ─────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
mobile/android/
mobile/ios/

# ─── Laravel ─────────────────────────────────────────────────
api/vendor/
api/storage/*.key
api/storage/framework/cache/
api/storage/framework/sessions/
api/storage/framework/views/
api/storage/logs/
api/public/storage
api/.phpunit.result.cache

# ─── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
