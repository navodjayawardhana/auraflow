APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. The only thing that sends any is the password reset code -- see
# App\Infrastructure\Auth\MailResetCodeNotifier.
#
# `log` is the shipped default and it is a working configuration, not a placeholder: the
# message is written to storage/logs/laravel.log, and because the mail is deliberately
# text-only the six digits sit on their own line, readable with
#
#     tail -f storage/logs/laravel.log
#
# That is how the reset flow is developed and demonstrated, and it needs no account
# anywhere. The code appearing in that file is the log standing in for a mailbox; nothing
# in the application writes a code, a token or a password to the log itself.
#
# Real delivery is these variables and nothing else -- no code changes. Point them at any
# SMTP host (Mailtrap, Brevo, Gmail with an app password, your own relay):
#
#     MAIL_MAILER=smtp
#     MAIL_HOST=smtp.your-provider.com
#     MAIL_PORT=587
#     MAIL_SCHEME=tls            # or `null` on port 465 with MAIL_ENCRYPTION=ssl
#     MAIL_USERNAME=your-username
#     MAIL_PASSWORD=your-password
#     MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
#     MAIL_FROM_NAME="AuraFlow"
#
# MAIL_FROM_ADDRESS matters more than it looks: a from-address on a domain you do not
# control is the fastest way to have every reset code land in spam.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Weather. Server-side only -- this key must never reach the app bundle, where an
# EXPO_PUBLIC_ variable would be readable from the APK. Free tier: openweathermap.org
OPENWEATHER_API_KEY=

# Gemini, for the daily briefing and the assistant. Server-side only -- an LLM key in a
# shipped bundle is a bill anyone can run up. Free tier: aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Meal photo recognitions per minute, per user. Every one is a paid model call carrying a
# megabyte of image, so the shipped default is deliberately tight; raise it locally while
# working on that screen. See the 'meal-photo' limiter in AppServiceProvider.
GEMINI_PHOTO_RATE_LIMIT=12
