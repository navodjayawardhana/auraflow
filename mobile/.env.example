# Copy to .env.local and point at your own setup.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time, so they
# are readable by anyone with the APK. Configuration only — never keys or tokens.

# A phone resolving "localhost" resolves itself, not your machine, so a physical device
# needs this machine's LAN address.
#   Android emulator   http://10.0.2.2:8000/api/v1
#   iOS simulator      http://localhost:8000/api/v1
#   Physical device    http://<your-LAN-ip>:8000/api/v1
EXPO_PUBLIC_API_URL=

# The IoT node's broker. wss (8884), never ws (8000): iOS App Transport Security blocks
# cleartext WebSockets on a physical device. See docs/adr/0003 for why this broker being
# public is an accepted prototype risk rather than an oversight.
EXPO_PUBLIC_MQTT_URL=wss://broker.hivemq.com:8884/mqtt

# Must match DEVICE_ID in iot/auraflow-node/secrets.h.
EXPO_PUBLIC_IOT_DEVICE_ID=auraflow-node-01

# Read by the Expo CLI, not by the app — it has no EXPO_PUBLIC_ prefix, so it never
# reaches the bundle.
#
# `expo-dev-client` is a dependency, so `expo start` puts the runtime-chooser page
# (/_expo/loading) in the QR code instead of the exp:// URL. On iOS that page is what the
# Camera app opens, and it answers 500 without a ?platform= parameter the QR does not
# carry — so scanning never reaches Expo Go. This restores the plain exp:// QR.
#
# Harmless when working against the development build: `--dev-client` skips the chooser
# on its own.
EXPO_NO_REDIRECT_PAGE=1
