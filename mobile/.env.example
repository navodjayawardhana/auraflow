# Copy to .env.local and point at wherever the API is running.
#
# EXPO_PUBLIC_ variables are inlined into the JavaScript bundle at build time, so they
# are readable by anyone with the APK. Only ever put non-secret configuration here --
# API keys stay server-side (see report 4.6).
#
#   Android emulator     http://10.0.2.2:8000     (10.0.2.2 is the host from inside the emulator)
#   iOS simulator        http://localhost:8000
#   Physical device      http://<your-LAN-ip>:8000
#
# Leave unset to let src/constants/api-config.ts guess from the platform.
EXPO_PUBLIC_API_URL=
